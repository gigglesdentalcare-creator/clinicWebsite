# Copy to .env.local and fill in. Never commit real secrets.

# Public URL of the site (used for metadata / sitemap). Use the Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS — project ID from https://www.sanity.io/manage (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer-role API token, server-only. Enables draft preview in Studio's Presentation tool.
SANITY_API_READ_TOKEN=
# Secret shared with the Sanity webhook that calls /api/revalidate (production).
SANITY_REVALIDATE_SECRET=

# --- Added in later phases ---
# Enquiry form (Phase 4)
# RESEND_API_KEY=
# CLINIC_INBOX_EMAIL=
# TURNSTILE_SECRET_KEY=
